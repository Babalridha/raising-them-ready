---
import BaseLayout from '../layouts/BaseLayout.astro';
const stages = ['Pregnancy & Birth', 'Baby & Toddler Years', 'Childhood', 'Teenage Years', 'Young Adulthood'];
---
<BaseLayout title="Resources | Raising Them Ready"><section class="resources-hero"><div class="container"><p class="eyebrow">Resources for your family</p><h1>Guidance for every stage of life</h1><p>Find faith-rooted tools, practical checklists, and gentle direction when you need them most.</p></div></section><section class="resource-list"><div class="container"><div class="resource-intro"><h2>Start where you are</h2><p>Each collection is shaped around the questions and changes that come with a new stage of family life.</p></div><div class="resource-stack">{stages.map((stage,index) => <a href="#" class="resource-row"><span>0{index + 1}</span><h2>{stage}</h2><p>Practical guides, checklists, and reflections for your family.</p><b>Explore <i aria-hidden="true">→</i></b></a>)}</div></div></section></BaseLayout>
<style>.resources-hero { padding:94px 0 80px; background:var(--mint); text-align:center; }.resources-hero .eyebrow { margin-bottom:12px; color:#28534b; font-size:14px; letter-spacing:0; text-transform:none; }.resources-hero h1 { max-width:730px; margin:auto; color:var(--deep); }.resources-hero p { max-width:640px; margin:19px auto 0; color:var(--muted); font-size:19px; }.resource-list { padding:82px 0 120px; }.resource-intro { display:grid; grid-template-columns:.7fr 1fr; gap:50px; align-items:end; margin-bottom:36px; }.resource-intro h2 { font-size:34px; }.resource-intro p { max-width:570px; margin:0; color:var(--muted); font-size:18px; }.resource-stack { border-top:1px solid var(--line); }.resource-row { display:grid; grid-template-columns:78px 1.05fr 1.2fr auto; gap:28px; align-items:center; padding:31px 18px; border-bottom:1px solid var(--line); transition:background .18s,padding .18s; }.resource-row:hover { padding-inline:27px; border-radius:18px; background:#f3f8f5; }.resource-row span { color:var(--gold); font-family:'DM Sans'; font-size:20px; font-weight:700; }.resource-row h2 { font-size:27px; }.resource-row p { margin:0; color:var(--muted); }.resource-row b { color:var(--green); white-space:nowrap; }.resource-row i { font-style:normal; transition:transform .18s; }.resource-row:hover i { display:inline-block; transform:translateX(4px); } @media(max-width:780px){.resources-hero { padding:62px 0 52px; text-align:left; }.resources-hero p { margin-left:0; }.resource-list { padding:54px 0 70px; }.resource-intro { grid-template-columns:1fr; gap:12px; margin-bottom:28px; }.resource-row { grid-template-columns:48px 1fr; gap:8px 12px; padding:24px 6px; }.resource-row p { grid-column:2; }.resource-row b { grid-column:2; margin-top:8px; }}</style>
