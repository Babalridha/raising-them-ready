---
import BaseLayout from '../layouts/BaseLayout.astro';
const pillars = [
  { icon:'/images/noun-play-2571303-3c674d-128-1-2.png', title:'Watch & Learn Together', text:'A growing collection of videos bringing Islamic parenting to life. Watch scholars and seasoned parents share Quranic references, hadith, and their insights.', points:['Multimodal content','Rooted in Quran & Hadith','Practical solutions to everyday challenges'], href:'/videos' },
  { icon:'/images/noun-document-5662585-9e4229-128-1-2.png', title:'Resources for Every Stage of Life', text:'Browse resources organized by age, from pregnancy to young adulthood. Find what you need exactly when you need it.', points:['Duas & food guide during pregnancy','Birth plans for hospital','How to organize your day'], href:'/resources' },
  { icon:'/images/noun-questionanswer-8258574-825500-128-1-2.png', title:'Get Your Questions Answered', text:'Search our Q&A archive for clear, faith-based answers. No question is too small when it comes to raising your family.', points:['Answers rooted in Quran & Hadith','Direct advice from scholars','Explore common everyday questions'], href:'/questions' },
];
---
<BaseLayout>
  <section class="hero"><div class="container hero-grid"><div class="hero-copy"><h1>Raising Them Ready</h1><p class="lead">Preparing parents for the greatest mission. Raising the next generation<br />of confident, compassionate, and connected Muslims.</p><div class="hero-actions"><a class="podcast-link" href="/audio"><span class="play-small">▶</span> Raising Them Ready Podcasts</a><a class="button" href="#foundation">Explore Free Resources <span>→</span></a></div></div><div class="hero-art"><img src="/images/raising-them-ready-cover-3.png" alt="A scholar recording the Raising Them Ready podcast" /></div></div></section>
  <section class="foundation" id="foundation"><div class="container"><header class="section-heading"><p class="eyebrow">Our Foundation</p><h2>Explore Content Tailored to Your Needs</h2><p>Multimodal content designed for practical, everyday life.</p></header><div class="pillar-grid">{pillars.map((pillar) => <a class="pillar" href={pillar.href}><div class="pillar-main"><img src={pillar.icon} alt="" /><h3>{pillar.title}</h3><p>{pillar.text}</p></div><ul>{pillar.points.map((point) => <li>{point}</li>)}</ul><span class="pillar-link">Explore <span>→</span></span></a>)}</div></div></section>
</BaseLayout>

<style>
  .hero { overflow:hidden; min-height:680px; background:var(--cream); }.hero-grid { min-height:680px; display:grid; grid-template-columns:55% 45%; align-items:stretch; }.hero-copy { display:flex; flex-direction:column; justify-content:center; padding:40px 8% 40px 0; }.hero h1 { color:#087f75; font-size:52px; }.hero .lead { margin:26px 0 34px; color:#515e59; font-size:19px; line-height:1.48; }.hero-actions { display:flex; align-items:center; gap:17px; flex-wrap:wrap; }.hero-actions span,.pillar-link span { margin-left:8px; }.podcast-link { display:inline-flex; align-items:center; gap:11px; min-height:62px; padding:12px 24px; border:1px solid #e7e0d5; border-radius:999px; background:white; box-shadow:0 3px 5px rgba(29,45,40,.09); color:#123630; font-size:15px; font-weight:700; }.play-small { display:grid; width:31px; height:31px; place-items:center; border-radius:50%; background:#e4f0e9; color:#367664; font-size:11px; }.hero-actions .button { min-height:50px; padding-inline:32px; font-size:15px; }.hero-art { height:100%; }.hero-art img { width:100%; height:100%; object-fit:cover; object-position:center; }
  .foundation { padding:92px 0 110px; background:white; }.section-heading { max-width:820px; text-align:center; margin:0 auto 72px; }.section-heading .eyebrow { margin-bottom:14px; padding:4px 13px; border-radius:999px; background:#e4f0e9; color:#163d35; font-size:13px; letter-spacing:0; text-transform:none; }.section-heading h2 { color:#087f75; font-size:38px; }.section-heading p:last-child { margin:20px 0 0; color:#515e59; font-size:18px; }.pillar-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:30px; }.pillar { display:flex; flex-direction:column; min-height:470px; border:1px solid transparent; border-radius:34px; background:#fffdf8; overflow:hidden; box-shadow:0 10px 22px rgba(24,64,55,.045); transition:transform .18s,box-shadow .18s; }.pillar:nth-child(3) { border-color:#e5ddd0; }.pillar:hover { transform:translateY(-5px); box-shadow:0 18px 34px rgba(24,64,55,.11); }.pillar-main { padding:37px 35px 20px; }.pillar-main img { width:60px; height:60px; object-fit:contain; margin-bottom:31px; }.pillar h3 { font-size:21px; }.pillar p { margin:17px 0 0; color:#505e59; font-size:16px; line-height:1.48; }.pillar ul { padding:0 35px; margin:0; list-style:none; border-top:1px solid #e9e3d8; }.pillar li { position:relative; padding:12px 0 0 21px; color:#344741; font-size:14px; }.pillar li:before { position:absolute; left:0; color:#367966; content:'●'; font-size:10px; }.pillar:nth-child(2) li:before { color:#b74930; }.pillar:nth-child(3) li:before { color:#946300; }.pillar-link { display:none; }
  @media(max-width:900px){.hero,.hero-grid { min-height:unset; }.hero-grid { grid-template-columns:1fr; }.hero-copy { padding:64px 0 48px; }.hero h1 { font-size:43px; }.hero .lead { margin:25px 0 33px; font-size:18px; }.hero .lead br { display:none; }.hero-art { height:390px; }.podcast-link { min-height:54px; padding:10px 18px; gap:9px; font-size:13px; }.play-small { width:25px; height:25px; font-size:9px; }.hero-actions .button { min-height:54px; padding-inline:20px; font-size:14px; }.foundation { padding:70px 0; }.section-heading { text-align:left; margin-bottom:40px; }.section-heading .eyebrow { padding:3px 10px; font-size:12px; }.section-heading h2 { font-size:32px; }.section-heading p:last-child { margin-top:14px; font-size:16px; }.pillar-grid { grid-template-columns:1fr; gap:22px; }.pillar { min-height:440px; border-radius:24px; }.pillar-main { padding:30px 28px 19px; }.pillar-main img { width:48px; height:48px; margin-bottom:24px; }.pillar h3 { font-size:25px; }.pillar p { margin-top:13px; font-size:16px; }.pillar ul { padding:0 28px; }.pillar li { padding:9px 0 0 20px; font-size:14px; }.pillar li:before { font-size:9px; }}
</style>
