---
import BaseLayout from '../layouts/BaseLayout.astro';
const faqs = [
  ['Sleep','Sleep Training','Is it okay to sleep train my child? Is it okay to put them in a separate room, and at what age? Can I let them cry themselves to sleep?','10'],
  ['Najasat','How do I purify my baby’s clothes?','Can I put my child’s najis clothes in the washing machine? How do I purify my carpet?','12'],
  ['Discipline','At what age should I discipline my child?','My two year old hit another child — should I scold them? My child is using inappropriate words — what should I do?','30'],
  ['Venting','Is it okay to talk about challenges I am having with my child?','Can I share my child’s sleep challenges, bad habits they have picked up, or my frustrations?','20'],
];
const alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');
---
<BaseLayout title="Questions & Answers | Raising Them Ready">
  <section class="qa-hero"><div class="container"><p class="eyebrow">A thoughtful place to begin</p><h1>Questions &amp; answers</h1><p>View questions by category, or search across all the guidance on this site — including videos and audio.</p><label><span class="sr-only">Search questions and answers</span><input type="search" placeholder="Search questions and answers" /></label></div></section>
  <section class="faq-section"><div class="container"><div class="faq-heading"><div><p class="eyebrow">Frequently Asked Questions</p><h2>Common Topics &amp; Issues</h2></div><a href="#topics">View All FAQs →</a></div><div class="faq-grid">{faqs.map(([category,title,description,count]) => <article class="faq-card"><span class="topic-tag">{category}</span><h3>{title}</h3><p>{description}</p><a href="#topics">Explore {count} Q&amp;As <span>→</span></a></article>)}</div></div></section>
  <section class="topics" id="topics"><div class="container"><header><p class="eyebrow">Search by topic</p><h2>Explore all Questions &amp; Answers</h2></header><div class="letters">{alphabet.map((letter) => <button type="button" aria-label={`Show topics beginning with ${letter}`}>{letter}</button>)}</div><div class="topic-columns">{['A','B','C','D','E'].map((letter) => <article><span>{letter}</span><a href="#">Topic X</a><a href="#">Topic X</a><a href="#">Topic X</a><a href="#">Topic X</a></article>)}</div></div></section>
</BaseLayout>
<style>
  .qa-hero { padding:90px 0 76px; background:var(--mint); text-align:center; }.qa-hero .eyebrow { margin-bottom:13px; color:#28534b; font-size:14px; letter-spacing:0; text-transform:none; }.qa-hero h1 { color:var(--deep); font-size:clamp(42px,5vw,62px); }.qa-hero p { max-width:660px; margin:18px auto 25px; color:var(--muted); font-size:18px; }.qa-hero input { width:min(560px,100%); height:54px; padding:0 18px; border:1px solid #a8c0b7; border-radius:999px; background:white; }.faq-section { padding:88px 0; }.faq-heading { display:flex; align-items:end; justify-content:space-between; gap:25px; margin-bottom:40px; }.faq-heading .eyebrow { margin-bottom:10px; color:var(--green); font-size:13px; letter-spacing:0; text-transform:none; }.faq-heading a { color:var(--green); font-weight:800; }.faq-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:20px; }.faq-card { display:flex; flex-direction:column; min-height:310px; padding:27px; border:1px solid var(--line); border-radius:24px; background:#fffefa; }.topic-tag { width:max-content; padding:4px 10px; border-radius:30px; background:#e9f3ee; color:var(--deep); font-size:13px; font-weight:800; }.faq-card h3 { margin:18px 0 10px; font-size:22px; }.faq-card p { margin:0; color:var(--muted); font-size:15px; }.faq-card a { margin-top:auto; padding-top:20px; color:var(--green); font-weight:800; }.topics { padding:88px 0 110px; background:#f1f6f3; }.topics header { text-align:center; }.topics .eyebrow { margin-bottom:10px; color:var(--green); font-size:13px; letter-spacing:0; text-transform:none; }.letters { display:flex; flex-wrap:wrap; justify-content:center; gap:8px; max-width:760px; margin:35px auto; }.letters button { display:grid; width:42px; height:42px; place-items:center; border:1px solid #b7d0c6; border-radius:50%; background:white; color:var(--green); cursor:pointer; }.letters button:hover { background:var(--deep); color:white; }.topic-columns { display:grid; grid-template-columns:repeat(5,1fr); gap:18px; }.topic-columns article { padding:22px; border-radius:20px; background:white; }.topic-columns span { display:block; margin-bottom:14px; color:var(--green); font-family:'DM Sans'; font-size:26px; font-weight:700; }.topic-columns a { display:block; padding:5px 0; color:#49635c; } @media(max-width:780px){.qa-hero { padding:58px 0 50px; text-align:left; }.qa-hero p { margin-left:0; }.faq-section { padding:60px 0; }.faq-heading { align-items:start; flex-direction:column; margin-bottom:28px; }.faq-grid { grid-template-columns:1fr; }.faq-card { min-height:unset; }.topic-columns { grid-template-columns:1fr 1fr; }.topics { padding:60px 0; }.topics header { text-align:left; }}
</style>
