---
interface Props { kind: 'Videos' | 'Audio'; intro: string; image: string; }
const { kind, intro, image } = Astro.props;
const cards = Array.from({ length: 9 }, (_, index) => ({ title: `A Practical Parenting Conversation ${index + 1}`, category: index % 2 ? 'Family life' : 'Faith & parenting', length: index % 3 === 0 ? '32 min' : '25 min' }));
---
<section class="library-hero"><div class="container"><p class="eyebrow">{kind}</p><h1>{kind === 'Videos' ? 'Watch and learn together' : 'Listen and learn together'}</h1><p>{intro}</p></div></section>
<section class="library"><div class="container"><div class="library-tools surface"><label><span>Find an episode</span><input type="search" placeholder={`Search ${kind.toLowerCase()}...`} /></label><label><span>Browse by theme</span><select><option>All episodes</option><option>Faith & parenting</option><option>Family life</option></select></label></div><p class="result-count">Showing the latest {kind.toLowerCase()} guidance</p><div class="media-grid">{cards.map((card) => <article class="media-card"><a class="thumbnail" href="#" aria-label={`Open ${card.title}`}><img src={image} alt="" />{kind === 'Videos' && <span class="play" aria-hidden="true">▶</span>}</a><div class="media-card-content"><div class="meta"><span>{card.category}</span><span>{card.length}</span></div><h2><a href="#">{card.title}</a></h2><p>Thoughtful, faith-based guidance for the everyday moments of family life.</p></div></article>)}</div></div></section>

<style>
  .library-hero { padding:90px 0 72px; background:var(--mint); text-align:center; }.library-hero .eyebrow { margin-bottom:13px; padding:4px 13px; border-radius:999px; background:rgba(255,255,255,.64); color:var(--deep); font-size:13px; letter-spacing:0; text-transform:none; }.library-hero h1 { max-width:760px; margin:0 auto; color:var(--deep); font-size:clamp(38px,4vw,56px); }.library-hero p:last-child { max-width:670px; margin:18px auto 0; color:var(--muted); font-size:18px; }.library { padding:65px 0 110px; }.library-tools { display:grid; grid-template-columns:1.5fr .7fr; gap:24px; align-items:end; margin-bottom:21px; padding:25px 28px; }.library-tools label { display:grid; gap:7px; color:#28534b; font-size:13px; font-weight:800; }.library-tools input,.library-tools select { min-height:47px; padding:0 14px; border:1px solid #bad0c8; border-radius:12px; background:white; color:var(--ink); font-weight:400; }.result-count { margin:0 0 26px; color:#5a7069; font-size:15px; }.media-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:26px; }.media-card { overflow:hidden; border:1px solid var(--line); border-radius:24px; background:#fffefa; transition:box-shadow .2s,transform .2s; }.media-card:hover { transform:translateY(-3px); box-shadow:0 14px 25px rgba(7,64,55,.1); }.thumbnail { position:relative; display:block; aspect-ratio:1.5; background:#dde7e2; overflow:hidden; }.thumbnail img { width:100%; height:100%; object-fit:cover; transition:transform .25s; }.media-card:hover .thumbnail img { transform:scale(1.03); }.play { position:absolute; inset:50% auto auto 50%; display:grid; width:52px; height:52px; place-items:center; border-radius:50%; background:var(--deep); color:white; transform:translate(-50%,-50%); }.media-card-content { padding:20px 21px 25px; }.meta { display:flex; justify-content:space-between; gap:10px; align-items:center; color:#57736b; font-size:13px; }.meta span:first-child { padding:3px 9px; border-radius:30px; background:#eaf3ef; color:var(--deep); font-weight:700; }.media-card h2 { margin:15px 0 8px; font-size:22px; }.media-card h2 a:hover { color:var(--green); }.media-card p { margin:0; color:var(--muted); font-size:15px; } @media(max-width:780px){.library-hero { padding:57px 0 40px; text-align:left; }.library-hero p:last-child { margin-left:0; }.library-tools { grid-template-columns:1fr; padding:20px; }.media-grid { grid-template-columns:1fr; }.library { padding:42px 0 68px; }}
</style>
